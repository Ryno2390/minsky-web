+  void UserFunction::updatePorts()
+  {
+    const size_t want=numPorts();
+    if (portsSize()==want) return;
+
+    // The OUTPUT port is deliberately kept rather than rebuilt. Destroying a port deletes
+    // the wires that end at it (~Port calls deleteWires), and the output wire cannot
+    // simply be put back: once the model has been reset, addWire refuses to wire the
+    // input of a variable the equations already define, so the function would silently
+    // lose whatever it fed. The output does not depend on the argument list anyway.
+    auto out=portsSize()>0? m_ports[0]: nullptr;
+
+    // Inputs do have to be rebuilt, so remember what fed each one -- the wire objects
+    // themselves are gone by the time the new ports exist.
+    vector<vector<shared_ptr<Port>>> suppliers;
+    for (size_t i=1; i<portsSize(); ++i)
+      {
+        suppliers.emplace_back();
+        if (auto p=ports(i).lock())
+          for (auto w: p->wires())
+            if (auto f=w->from())
+              suppliers.back().push_back(f);
+      }
+
+    m_ports.clear();
+    if (out)
+      m_ports.push_back(out);
+    else if (want>0)
+      m_ports.emplace_back(make_shared<Port>(*this));
+    for (size_t i=1; i<want; ++i)
+      m_ports.emplace_back(make_shared<InputPort>(*this));
+
+    // put back every input that still has an argument to land on. The ones whose argument
+    // has gone stay gone, which is the only honest thing to do with them.
+    if (auto g=group.lock())
+      for (size_t i=0; i+1<portsSize() && i<suppliers.size(); ++i)
+        if (auto to=ports(i+1).lock())
+          for (auto& from: suppliers[i])
+            g->addWire(from, to);
+
+    // The icon's size and its port positions are both worked out by drawing it, so
+    // without this it keeps the shape the function had before the argument list changed.
+    updateBoundingBox();
+  }
